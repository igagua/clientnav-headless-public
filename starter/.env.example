# The CMS (WordPress with Client Navigator Headless)
CMS_URL=https://cms.example.com
# This front end's public address
SITE_URL=https://www.example.com
# Written by pairing: npx clientnav-headless-pair --cms "$CMS_URL" CODE
REVALIDATE_SECRET=
# true lets search engines list the site; leave it unset on a beta address and set it at the switch
SITE_INDEXABLE=
# Client Navigator Anti-Spam, headless mode: the same secret as on the CMS (Client Navigator > Connection); empty while off
CLIENTNAV_ANTISPAM_SECRET=
# Matomo (your own): the address and this site's number there. Visits count only on SITE_URL's own host
MATOMO_URL=https://stats.example.com
MATOMO_SITE_ID=
