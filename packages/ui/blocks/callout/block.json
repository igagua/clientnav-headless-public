{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clientnav/callout",
  "title": "Dark callout",
  "category": "clientnav",
  "icon": "megaphone",
  "description": "A dark box with a title, a text and one button, as under a roadmap.",
  "keywords": [],
  "textdomain": "clientnav-headless",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "text": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "buttonLabel": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "href": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "clientnav-headless-editor",
  "editorStyle": "clientnav-headless-ui",
  "clientnav": {
    "fields": {
      "eyebrow": {
        "kind": "text",
        "label": "Small line above"
      },
      "title": {
        "kind": "text",
        "label": "Title"
      },
      "text": {
        "kind": "text",
        "label": "Text"
      },
      "buttonLabel": {
        "kind": "text",
        "label": "Button"
      },
      "href": {
        "kind": "link",
        "label": "Button address"
      }
    }
  }
}
