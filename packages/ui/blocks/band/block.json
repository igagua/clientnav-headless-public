{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clientnav/band",
  "title": "Closing band",
  "category": "clientnav",
  "icon": "button",
  "description": "The coloured band with one call to action.",
  "keywords": [],
  "textdomain": "clientnav-headless",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "accent": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "text": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "buttonLabel": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "buttonHref": {
      "type": "string",
      "default": ""
    },
    "noteLabel": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "noteHref": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "clientnav-headless-editor",
  "editorStyle": "clientnav-headless-ui",
  "clientnav": {
    "fields": {
      "eyebrow": {
        "kind": "text",
        "label": "Small line above"
      },
      "title": {
        "kind": "text",
        "label": "Title"
      },
      "accent": {
        "kind": "text",
        "label": "Title, tinted part"
      },
      "text": {
        "kind": "text",
        "label": "Text"
      },
      "buttonLabel": {
        "kind": "text",
        "label": "Button"
      },
      "buttonHref": {
        "kind": "link",
        "label": "Button address"
      },
      "noteLabel": {
        "kind": "text",
        "label": "Second line"
      },
      "noteHref": {
        "kind": "link",
        "label": "Second line address"
      }
    }
  }
}
