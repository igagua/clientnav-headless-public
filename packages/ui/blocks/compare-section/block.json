{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clientnav/compare-section",
  "title": "Table section",
  "category": "clientnav",
  "icon": "table-row-before",
  "description": "A titled group of rows.",
  "keywords": [],
  "textdomain": "clientnav-headless",
  "attributes": {
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "clientnav-headless-editor",
  "editorStyle": "clientnav-headless-ui",
  "clientnav": {
    "fields": {
      "title": {
        "kind": "text",
        "label": "Section title"
      }
    },
    "inner": {
      "allowed": [
        "clientnav/compare-row"
      ],
      "template": 3
    }
  },
  "parent": [
    "clientnav/compare"
  ]
}
