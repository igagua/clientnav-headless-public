{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clientnav/inquiry",
  "title": "Inquiry",
  "category": "clientnav",
  "icon": "email",
  "description": "The call to get in touch about this page's subject.",
  "keywords": [],
  "textdomain": "clientnav-headless",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "accent": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "text": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "phoneLabel": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "phoneHref": {
      "type": "string",
      "default": ""
    },
    "topic": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "buttonLabel": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "buttonHref": {
      "type": "string",
      "default": ""
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "subject": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "clientnav-headless-editor",
  "editorStyle": "clientnav-headless-ui",
  "clientnav": {
    "fields": {
      "eyebrow": {
        "kind": "text",
        "label": "Small line above"
      },
      "title": {
        "kind": "text",
        "label": "Title"
      },
      "accent": {
        "kind": "text",
        "label": "Title, tinted part"
      },
      "text": {
        "kind": "text",
        "label": "Text"
      },
      "subject": {
        "kind": "plain",
        "label": "Subject the form starts with (for example a service's name)"
      },
      "phoneLabel": {
        "kind": "text",
        "label": "Phone"
      },
      "phoneHref": {
        "kind": "link",
        "label": "Phone address (tel:)"
      },
      "topic": {
        "kind": "text",
        "label": "Small line"
      },
      "buttonLabel": {
        "kind": "text",
        "label": "Button"
      },
      "buttonHref": {
        "kind": "link",
        "label": "Button address"
      },
      "anchor": {
        "kind": "plain",
        "label": "Anchor (for links like #overview)"
      }
    }
  }
}
