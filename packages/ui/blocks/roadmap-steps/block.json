{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "clientnav/roadmap-steps",
  "title": "Roadmap steps",
  "category": "clientnav",
  "icon": "editor-ol",
  "description": "A titled row of numbered steps on the dark roadmap background.",
  "keywords": [],
  "textdomain": "clientnav-headless",
  "attributes": {
    "title": {
      "type": "string",
      "default": "",
      "role": "content"
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": false,
    "anchor": false
  },
  "editorScript": "clientnav-headless-editor",
  "editorStyle": "clientnav-headless-ui",
  "clientnav": {
    "fields": {
      "title": {
        "kind": "text",
        "label": "Title"
      }
    },
    "inner": {
      "allowed": [
        "clientnav/roadmap-step"
      ],
      "template": 3
    }
  }
}
